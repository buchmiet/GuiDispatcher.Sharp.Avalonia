<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GuiDispatcher.Sharp.Avalonia</RootNamespace>

    <PackageId>GuiDispatcher.Sharp.Avalonia</PackageId>
    <Version>1.1.1</Version>
    <Authors>Lukasz Buchmiet</Authors>
    <Description>Avalonia 12 implementation of GuiDispatcher.Sharp for .NET 10.</Description>
    <PackageTags>dispatcher;ui;gui;thread;timer;avalonia</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/buchmiet/GuiDispatcher.Sharp.Avalonia</RepositoryUrl>
    <PackageProjectUrl>https://github.com/buchmiet/GuiDispatcher.Sharp.Avalonia</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="GuiDispatcher.Sharp" Version="[1.1.0,2.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Content Remove="tests/**" />
    <AvaloniaXaml Remove="tests/**" />
  </ItemGroup>

</Project>
